PROJECT_NAME="IS Compliance & Verification Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=False

# Database
DATABASE_URL="sqlite:///./data/is_platform.db"

# Authentication & Security
# Leave empty for a random development-only key, or generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# CORS (JSON string array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Storage & Uploads
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB=50

# AI & Embedding Engine
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
RAG_CONFIDENCE_THRESHOLD=0.65
